// Auxiliares dos testes: sistemas falsos da linha de comando e do sistema de arquivos.
importar tudo como textos de "../fontes/utilidades/texto.delegua"
importar { EntradaDiretorio, SistemaArquivosDescoberta, SistemaCli } de "../fontes/modelos.delegua"

// Sistema da linha de comando em memória. `arquivos` é um dicionário caminho → conteúdo;
// caminhos relativos são resolvidos a partir de "/projeto".
classe SistemaCliFalso herda SistemaCli {
    argumentos: texto[]
    arquivos: dicionário
    saida: texto
    erro: texto
    codigo: inteiro

    construtor(argumentos: texto[], arquivos: dicionário) {
        isto.argumentos = argumentos
        isto.arquivos = arquivos
        isto.saida = ""
        isto.erro = ""
        isto.codigo = -1
    }

    obterArgumentos(): texto[] {
        retorna isto.argumentos
    }

    lerArquivo(caminho: texto): texto {
        retorna isto.arquivos[caminho]
    }

    diretorioAtual(): texto {
        retorna "/projeto"
    }

    juntarCaminhos(base: texto, parte: texto): texto {
        retorna base + "/" + parte
    }

    resolverCaminho(base: texto, caminho: texto): texto {
        se (textos.comecaCom(caminho, "/")) { retorna caminho }
        retorna base + "/" + caminho
    }

    escreverSaida(conteudo: texto) {
        isto.saida = isto.saida + conteudo
    }

    escreverErro(conteudo: texto) {
        isto.erro = isto.erro + conteudo
    }

    encerrar(codigo: inteiro) {
        isto.codigo = codigo
    }

    existe(caminho: texto): lógico {
        retorna isto.arquivos.contem(caminho)
    }
}

funcao sistemaCli(argumentos: texto[], arquivos: dicionário): SistemaCliFalso {
    retorna SistemaCliFalso(argumentos, arquivos)
}

// Sistema de arquivos de descoberta em memória. `arquivos` é um dicionário caminho →
// conteúdo; os diretórios são deduzidos dos caminhos.
classe SistemaArquivosFalso herda SistemaArquivosDescoberta {
    arquivos: dicionário

    construtor(arquivos: dicionário) {
        isto.arquivos = arquivos
    }

    ehDiretorio(caminho: texto): lógico {
        var caminhos: texto[] = isto.arquivos.chaves()
        para (var i = 0; i < caminhos.tamanho(); i = i + 1) {
            se (textos.comecaCom(caminhos[i], caminho + "/")) { retorna verdadeiro }
        }
        retorna falso
    }

    existe(caminho: texto): lógico {
        retorna isto.arquivos.contem(caminho) ou isto.ehDiretorio(caminho)
    }

    listarDiretorio(caminho: texto): EntradaDiretorio[] {
        var nomes: texto[] = []
        var entradas: EntradaDiretorio[] = []
        var caminhos: texto[] = isto.arquivos.chaves()
        para (var i = 0; i < caminhos.tamanho(); i = i + 1) {
            var atual: texto = caminhos[i]
            se (textos.comecaCom(atual, caminho + "/")) {
                var resto: texto = atual.subtexto(caminho.tamanho() + 1, atual.tamanho())
                var nome: texto = resto.dividir("/")[0]
                se (nao nomes.inclui(nome)) {
                    nomes.adicionar(nome)
                    entradas.adicionar(EntradaDiretorio(nome, resto.inclui("/")))
                }
            }
        }
        retorna entradas
    }

    lerTexto(caminho: texto): texto {
        retorna isto.arquivos[caminho]
    }

    juntarCaminhos(base: texto, parte: texto): texto {
        retorna base + "/" + parte
    }
}

funcao sistemaArquivos(arquivos: dicionário): SistemaArquivosFalso {
    retorna SistemaArquivosFalso(arquivos)
}

// Primeiro item de `lista` cujo campo `nome` é `nome`, ou nulo.
funcao porNome(lista, nome) {
    para (var i = 0; i < lista.tamanho(); i = i + 1) {
        se (lista[i].nome == nome) { retorna lista[i] }
    }
    retorna nulo
}
