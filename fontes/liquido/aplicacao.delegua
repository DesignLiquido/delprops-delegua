// Propriedades de liquido.aplicacao.*.
importar { DefinicaoPropriedade } de "../modelos.delegua"

funcao definicoes(): DefinicaoPropriedade[] {
    var lista: DefinicaoPropriedade[] = [
        DefinicaoPropriedade("nome", "texto", "Nome da aplicação.", "", []),
        DefinicaoPropriedade("versao", "texto", "Versão da aplicação.", "", []),
        DefinicaoPropriedade("descricao", "texto", "Descrição da aplicação.", "", []),
        DefinicaoPropriedade("licenca.nome", "texto", "Nome da licença da aplicação.", "", []),
        DefinicaoPropriedade("licenca.url", "texto", "URL da licença da aplicação.", "", [])
    ]
    retorna lista
}
