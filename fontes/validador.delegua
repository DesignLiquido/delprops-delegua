// Validação de propriedades compreendidas contra esquemas conhecidos.
importar tudo como textos de "./utilidades/texto.delegua"
importar {
    AvisoValidacao,
    DefinicaoPropriedade,
    ErroValidacao,
    PropriedadeCompreendida,
    ResultadoValidacao
} de "./modelos.delegua"

// Espaço de nomes com sub-espaço dinâmico: liquido.dados.<nome>.<propriedade>.
funcao espacoNomesDados(): texto {
    retorna "liquido.dados"
}

funcao ehTextoEntreAspas(valor: texto): lógico {
    retorna valor.tamanho() >= 2 e textos.comecaCom(valor, "'") e textos.terminaCom(valor, "'")
}

// Infere o tipo de um valor a partir de sua representação textual:
// - `verdadeiro` / `falso` → "logico"
// - valor entre aspas simples → "texto"
// - números inteiros e decimais → "numero"
// - caso contrário → "" (tipo desconhecido)
funcao inferirTipo(valor: texto): texto {
    se (valor == "verdadeiro" ou valor == "falso") { retorna "logico" }
    se (ehTextoEntreAspas(valor)) { retorna "texto" }
    se (textos.ehNumeroDecimal(valor)) { retorna "numero" }
    retorna ""
}

// Remove as aspas simples do valor, se houver.
funcao valorSemAspas(valor: texto): texto {
    se (ehTextoEntreAspas(valor)) { retorna valor.subtexto(1, valor.tamanho() - 1) }
    retorna valor
}

// Une duas definições de mesmo nome (por exemplo, a embutida e a de um pacote que estende o
// espaço de nomes). Se ambas restringem os valores, os permitidos são somados; senão, vale
// a definição mais recente.
funcao unirDefinicoes(anterior: DefinicaoPropriedade, nova: DefinicaoPropriedade): DefinicaoPropriedade {
    se (nao anterior.temValoresPermitidos() ou nao nova.temValoresPermitidos()) { retorna nova }
    se (anterior.tipoValor != nova.tipoValor) { retorna nova }
    var permitidos: texto[] = []
    para (var i = 0; i < anterior.valoresPermitidos.tamanho(); i = i + 1) {
        permitidos.adicionar(anterior.valoresPermitidos[i])
    }
    para (var j = 0; j < nova.valoresPermitidos.tamanho(); j = j + 1) {
        var permitido: texto = nova.valoresPermitidos[j]
        se (nao permitidos.inclui(permitido)) { permitidos.adicionar(permitido) }
    }
    var valorPadrao: texto = nova.valorPadrao
    se (valorPadrao == "") { valorPadrao = anterior.valorPadrao }
    retorna DefinicaoPropriedade(nova.nome, nova.tipoValor, nova.detalhe, valorPadrao, permitidos)
}

// Espaço de nomes → (nome da propriedade → definição).
funcao construirMapasConsulta(esquemas: dicionário): dicionário {
    var mapas: dicionário = {}
    var espacos: texto[] = esquemas.chaves()
    para (var i = 0; i < espacos.tamanho(); i = i + 1) {
        var espaco: texto = espacos[i]
        var definicoes: DefinicaoPropriedade[] = esquemas[espaco]
        var mapa: dicionário = {}
        para (var j = 0; j < definicoes.tamanho(); j = j + 1) {
            var definicao: DefinicaoPropriedade = definicoes[j]
            se (mapa.contem(definicao.nome)) {
                // Copiar por uma variável local: guardar o retorno direto no dicionário
                // deixa uma referência inválida no interpretador.
                var anterior: DefinicaoPropriedade = mapa[definicao.nome]
                var unida: DefinicaoPropriedade = unirDefinicoes(anterior, definicao)
                mapa[definicao.nome] = unida
            } senao {
                mapa[definicao.nome] = definicao
            }
        }
        mapas[espaco] = mapa
    }
    retorna mapas
}

// Último segmento de um caminho com pontos: `liquido.arquetipo` → `arquetipo`.
funcao ultimoSegmento(caminho: texto): texto {
    var partes: texto[] = caminho.dividir(".")
    retorna partes[partes.tamanho() - 1]
}

// Extrai o nome da propriedade a partir da chave completa. Em `liquido.dados`, descarta o
// sub-espaço dinâmico: `liquido.dados.lincones.tecnologia` → `tecnologia`.
// Se a chave é o próprio espaço de nomes, devolve "" (o chamador decide).
funcao extrairNomePropriedade(espacoNomes: texto, chave: texto): texto {
    se (chave == espacoNomes) { retorna "" }
    var restante: texto = chave.subtexto(espacoNomes.tamanho() + 1, chave.tamanho())
    se (espacoNomes == espacoNomesDados()) {
        var indicePonto: inteiro = restante.encontrar(".")
        se (indicePonto < 0) { retorna "" }
        retorna restante.subtexto(indicePonto + 1, restante.tamanho())
    }
    retorna restante
}

// Espaço de nomes mais específico que contém a chave, ou "".
funcao encontrarEspacoNomes(nomesOrdenados: texto[], chave: texto): texto {
    para (var i = 0; i < nomesOrdenados.tamanho(); i = i + 1) {
        var espaco: texto = nomesOrdenados[i]
        se (chave == espaco ou textos.comecaCom(chave, espaco + ".")) { retorna espaco }
    }
    retorna ""
}

// Nomes dos espaços de nomes, do mais longo ao mais curto: 'liquido.aplicacao' antes de
// 'liquido'. Entre nomes de mesmo tamanho, mantém a ordem original.
funcao ordenarPorTamanhoDecrescente(nomes: texto[]): texto[] {
    // Ordenação por inserção, no próprio vetor: cada nome novo recua enquanto o anterior
    // for mais curto.
    var ordenados: texto[] = []
    para (var i = 0; i < nomes.tamanho(); i = i + 1) {
        var nome: texto = nomes[i]
        ordenados.adicionar(nome)
        var j: inteiro = ordenados.tamanho() - 1
        enquanto (j > 0) {
            var anterior: texto = ordenados[j - 1]
            se (anterior.tamanho() >= nome.tamanho()) { sustar }
            ordenados[j] = anterior
            ordenados[j - 1] = nome
            j = j - 1
        }
    }
    retorna ordenados
}

// Valida propriedades compreendidas contra os esquemas (dicionário: espaço de nomes →
// vetor de DefinicaoPropriedade). Para chaves de espaços de nomes conhecidos:
// - propriedade desconhecida gera aviso;
// - tipo de valor incompatível gera erro;
// - valor fora dos permitidos gera erro.
// Chaves de espaços de nomes desconhecidos não são validadas.
funcao validar(propriedades: PropriedadeCompreendida[], esquemas: dicionário): ResultadoValidacao {
    var avisos: AvisoValidacao[] = []
    var erros: ErroValidacao[] = []
    var mapasConsulta: dicionário = construirMapasConsulta(esquemas)
    var nomesEspacos: texto[] = ordenarPorTamanhoDecrescente(esquemas.chaves())

    para (var i = 0; i < propriedades.tamanho(); i = i + 1) {
        var propriedade: PropriedadeCompreendida = propriedades[i]
        var espaco: texto = encontrarEspacoNomes(nomesEspacos, propriedade.chave)
        se (espaco == "") { continua }

        var mapa: dicionário = mapasConsulta[espaco]
        var nomePropriedade: texto = extrairNomePropriedade(espaco, propriedade.chave)

        // Propriedade com o mesmo nome do espaço de nomes: `liquido.arquetipo = 'mvc'`
        // valida contra a propriedade `arquetipo` de `liquido.arquetipo`.
        se (nomePropriedade == "" e propriedade.chave == espaco e mapa.contem(ultimoSegmento(espaco))) {
            nomePropriedade = ultimoSegmento(espaco)
        }

        se (nomePropriedade == "") {
            avisos.adicionar(AvisoValidacao(
                propriedade.chave,
                propriedade.linha,
                "Espaço de nomes '" + espaco + "' sem nome de propriedade."
            ))
            continua
        }

        se (nao mapa.contem(nomePropriedade)) {
            avisos.adicionar(AvisoValidacao(
                propriedade.chave,
                propriedade.linha,
                "Propriedade '" + nomePropriedade + "' desconhecida no espaço de nomes '" + espaco + "'."
            ))
            continua
        }
        var definicao: DefinicaoPropriedade = mapa[nomePropriedade]

        var tipoInferido: texto = inferirTipo(propriedade.valor)
        se (tipoInferido == "") {
            erros.adicionar(ErroValidacao(
                propriedade.chave,
                propriedade.linha,
                "Valor '" + propriedade.valor + "' não corresponde a nenhum tipo conhecido (logico, texto, numero)."
            ))
            continua
        }

        se (tipoInferido != definicao.tipoValor) {
            erros.adicionar(ErroValidacao(
                propriedade.chave,
                propriedade.linha,
                "Tipo esperado '" + definicao.tipoValor + "', mas o valor '" + propriedade.valor + "' parece ser '" + tipoInferido + "'."
            ))
            continua
        }

        se (definicao.temValoresPermitidos()) {
            var valorLimpo: texto = valorSemAspas(propriedade.valor)
            se (nao definicao.valoresPermitidos.inclui(valorLimpo)) {
                erros.adicionar(ErroValidacao(
                    propriedade.chave,
                    propriedade.linha,
                    "Valor '" + valorLimpo + "' não está entre os permitidos: [" + definicao.valoresPermitidos.juntar(", ") + "]."
                ))
            }
        }
    }

    retorna ResultadoValidacao(avisos, erros)
}
