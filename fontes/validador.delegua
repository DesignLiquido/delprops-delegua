// Validação de propriedades compreendidas contra esquemas conhecidos.
importar tudo como modelos de "./modelos.delegua"
importar tudo como textos de "./utilidades/texto.delegua"

// Espaço de nomes com sub-espaço dinâmico: liquido.dados.<nome>.<propriedade>.
funcao espacoNomesDados() {
    retorna "liquido.dados"
}

funcao ehTextoEntreAspas(valor) {
    retorna valor.tamanho() >= 2 e textos.comecaCom(valor, "'") e textos.terminaCom(valor, "'")
}

// Infere o tipo de um valor a partir de sua representação textual:
// - `verdadeiro` / `falso` → "logico"
// - valor entre aspas simples → "texto"
// - números inteiros e decimais → "numero"
// - caso contrário → nulo
funcao inferirTipo(valor) {
    se (valor == "verdadeiro" ou valor == "falso") { retorna "logico" }
    se (ehTextoEntreAspas(valor)) { retorna "texto" }
    se (textos.ehNumeroDecimal(valor)) { retorna "numero" }
    retorna nulo
}

// Remove as aspas simples do valor, se houver.
funcao valorSemAspas(valor) {
    se (ehTextoEntreAspas(valor)) { retorna valor.subtexto(1, valor.tamanho() - 1) }
    retorna valor
}

// Une duas definições de mesmo nome (por exemplo, a embutida e a de um pacote que estende o
// espaço de nomes). Se ambas restringem os valores, os permitidos são somados; senão, vale
// a definição mais recente.
funcao unirDefinicoes(anterior, nova) {
    se (anterior.valoresPermitidos == nulo ou nova.valoresPermitidos == nulo) { retorna nova }
    se (anterior.tipoValor != nova.tipoValor) { retorna nova }
    var permitidos = []
    para (var i = 0; i < anterior.valoresPermitidos.tamanho(); i = i + 1) {
        permitidos.adicionar(anterior.valoresPermitidos[i])
    }
    para (var j = 0; j < nova.valoresPermitidos.tamanho(); j = j + 1) {
        var permitido = nova.valoresPermitidos[j]
        se (nao permitidos.inclui(permitido)) { permitidos.adicionar(permitido) }
    }
    var valorPadrao = nova.valorPadrao
    se (valorPadrao == nulo) { valorPadrao = anterior.valorPadrao }
    retorna modelos.DefinicaoPropriedade(nova.nome, nova.tipoValor, nova.detalhe, valorPadrao, permitidos)
}

// Espaço de nomes → (nome da propriedade → definição).
funcao construirMapasConsulta(esquemas) {
    var mapas = {}
    var espacos = esquemas.chaves()
    para (var i = 0; i < espacos.tamanho(); i = i + 1) {
        var espaco = espacos[i]
        var definicoes = esquemas[espaco]
        var mapa = {}
        para (var j = 0; j < definicoes.tamanho(); j = j + 1) {
            var definicao = definicoes[j]
            se (mapa.contem(definicao.nome)) {
                // Copiar por uma variável local: guardar o retorno direto no dicionário
                // deixa uma referência inválida no interpretador.
                var anterior = mapa[definicao.nome]
                var unida = unirDefinicoes(anterior, definicao)
                mapa[definicao.nome] = unida
            } senao {
                mapa[definicao.nome] = definicao
            }
        }
        mapas[espaco] = mapa
    }
    retorna mapas
}

// Último segmento de um caminho com pontos: `liquido.arquetipo` → `arquetipo`.
funcao ultimoSegmento(caminho) {
    var partes = caminho.dividir(".")
    retorna partes[partes.tamanho() - 1]
}

// Extrai o nome da propriedade a partir da chave completa. Em `liquido.dados`, descarta o
// sub-espaço dinâmico: `liquido.dados.lincones.tecnologia` → `tecnologia`.
// Se a chave é o próprio espaço de nomes, devolve "" (o chamador decide).
funcao extrairNomePropriedade(espacoNomes, chave) {
    se (chave == espacoNomes) { retorna "" }
    var restante = chave.subtexto(espacoNomes.tamanho() + 1, chave.tamanho())
    se (espacoNomes == espacoNomesDados()) {
        var indicePonto = restante.encontrar(".")
        se (indicePonto < 0) { retorna "" }
        retorna restante.subtexto(indicePonto + 1, restante.tamanho())
    }
    retorna restante
}

// Espaço de nomes mais específico que contém a chave, ou nulo.
funcao encontrarEspacoNomes(nomesOrdenados, chave) {
    para (var i = 0; i < nomesOrdenados.tamanho(); i = i + 1) {
        var espaco = nomesOrdenados[i]
        se (chave == espaco ou textos.comecaCom(chave, espaco + ".")) { retorna espaco }
    }
    retorna nulo
}

// Valida propriedades compreendidas contra os esquemas (dicionário: espaço de nomes →
// vetor de DefinicaoPropriedade). Para chaves de espaços de nomes conhecidos:
// - propriedade desconhecida gera aviso;
// - tipo de valor incompatível gera erro;
// - valor fora dos permitidos gera erro.
// Chaves de espaços de nomes desconhecidos não são validadas.
// Devolve um ResultadoValidacao.
funcao validar(propriedades, esquemas) {
    var avisos = []
    var erros = []
    var mapasConsulta = construirMapasConsulta(esquemas)

    // Do mais específico ao menos específico: 'liquido.aplicacao' antes de 'liquido'.
    var nomesEspacos = esquemas.chaves().ordenar(funcao(a, b) { retorna b.tamanho() - a.tamanho() })

    para (var i = 0; i < propriedades.tamanho(); i = i + 1) {
        var propriedade = propriedades[i]
        var espaco = encontrarEspacoNomes(nomesEspacos, propriedade.chave)
        se (espaco == nulo) { continua }

        var mapa = mapasConsulta[espaco]
        var nomePropriedade = extrairNomePropriedade(espaco, propriedade.chave)

        // Propriedade com o mesmo nome do espaço de nomes: `liquido.arquetipo = 'mvc'`
        // valida contra a propriedade `arquetipo` de `liquido.arquetipo`.
        se (nomePropriedade == "" e propriedade.chave == espaco e mapa.contem(ultimoSegmento(espaco))) {
            nomePropriedade = ultimoSegmento(espaco)
        }

        se (nomePropriedade == "") {
            avisos.adicionar(modelos.AvisoValidacao(
                propriedade.chave,
                propriedade.linha,
                "Espaço de nomes '" + espaco + "' sem nome de propriedade."
            ))
            continua
        }

        se (nao mapa.contem(nomePropriedade)) {
            avisos.adicionar(modelos.AvisoValidacao(
                propriedade.chave,
                propriedade.linha,
                "Propriedade '" + nomePropriedade + "' desconhecida no espaço de nomes '" + espaco + "'."
            ))
            continua
        }
        var definicao = mapa[nomePropriedade]

        var tipoInferido = inferirTipo(propriedade.valor)
        se (tipoInferido == nulo) {
            erros.adicionar(modelos.ErroValidacao(
                propriedade.chave,
                propriedade.linha,
                "Valor '" + propriedade.valor + "' não corresponde a nenhum tipo conhecido (logico, texto, numero)."
            ))
            continua
        }

        se (tipoInferido != definicao.tipoValor) {
            erros.adicionar(modelos.ErroValidacao(
                propriedade.chave,
                propriedade.linha,
                "Tipo esperado '" + definicao.tipoValor + "', mas o valor '" + propriedade.valor + "' parece ser '" + tipoInferido + "'."
            ))
            continua
        }

        var permitidos = definicao.valoresPermitidos
        se (permitidos != nulo e permitidos.tamanho() > 0) {
            var valorLimpo = valorSemAspas(propriedade.valor)
            se (nao permitidos.inclui(valorLimpo)) {
                erros.adicionar(modelos.ErroValidacao(
                    propriedade.chave,
                    propriedade.linha,
                    "Valor '" + valorLimpo + "' não está entre os permitidos: [" + permitidos.juntar(", ") + "]."
                ))
            }
        }
    }

    retorna modelos.ResultadoValidacao(avisos, erros)
}
