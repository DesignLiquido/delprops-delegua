// Análise de JSON (e JSONC) escrita em Delégua.
//
// O módulo `json` tem interfaces diferentes nas realizações node e llvm, então o DelProps
// usa esta implementação própria, que funciona igual em todas. Os valores lidos são
// instâncias de `ValorJson`, com o tipo JSON em `tipoJson`: o compilador LLVM só conhece
// tipos em tempo de compilação, então dicionários e vetores com valores de tipos misturados
// não servem para representar JSON.

// Um valor JSON. `tipoJson` é "objeto", "vetor", "texto", "numero", "logico" ou "nulo";
// só o campo correspondente ao tipo tem conteúdo.
classe ValorJson {
    tipoJson: texto
    textoValor: texto
    numeroValor: número
    logicoValor: lógico
    // Itens de um vetor.
    itens: ValorJson[]
    // Campos de um objeto: chave → ValorJson.
    campos: dicionário
    // Chaves de um objeto, na ordem em que aparecem no texto.
    chaves: texto[]

    construtor(tipoJson: texto) {
        isto.tipoJson = tipoJson
        isto.textoValor = ""
        isto.numeroValor = 0
        isto.logicoValor = falso
        isto.itens = []
        isto.campos = {}
        isto.chaves = []
    }

    ehObjeto(): lógico {
        retorna isto.tipoJson == "objeto"
    }

    ehVetor(): lógico {
        retorna isto.tipoJson == "vetor"
    }

    ehTexto(): lógico {
        retorna isto.tipoJson == "texto"
    }

    // Verdadeiro se é um objeto com a chave dada.
    contem(chave: texto): lógico {
        retorna isto.tipoJson == "objeto" e isto.campos.contem(chave)
    }

    // O campo de um objeto, ou um valor nulo se o valor não é objeto ou não tem a chave.
    campo(chave: texto): ValorJson {
        se (nao isto.contem(chave)) {
            retorna ValorJson("nulo")
        }
        var lido: ValorJson = isto.campos[chave]
        retorna lido
    }

    // O texto de um campo, ou "" se o campo não existe ou não é texto.
    textoDoCampo(chave: texto): texto {
        var lido: ValorJson = isto.campo(chave)
        se (lido.tipoJson == "texto") {
            retorna lido.textoValor
        }
        retorna ""
    }

    definirCampo(chave: texto, valor: ValorJson) {
        se (nao isto.campos.contem(chave)) {
            isto.chaves.adicionar(chave)
        }
        isto.campos[chave] = valor
    }
}

// Resultado de uma análise: `erro` vazio indica sucesso.
classe ResultadoJson {
    valor: ValorJson
    erro: texto

    construtor(valor: ValorJson, erro: texto) {
        isto.valor = valor
        isto.erro = erro
    }
}

// Resultado de `removerComentarios`: `erro` vazio indica sucesso.
classe ResultadoTextoJson {
    textoLimpo: texto
    erro: texto

    construtor(textoLimpo: texto, erro: texto) {
        isto.textoLimpo = textoLimpo
        isto.erro = erro
    }
}

funcao criarTextoJson(valor: texto): ValorJson {
    var resultado: ValorJson = ValorJson("texto")
    resultado.textoValor = valor
    retorna resultado
}

funcao criarNumeroJson(valor: número): ValorJson {
    var resultado: ValorJson = ValorJson("numero")
    resultado.numeroValor = valor
    retorna resultado
}

funcao criarLogicoJson(valor: lógico): ValorJson {
    var resultado: ValorJson = ValorJson("logico")
    resultado.logicoValor = valor
    retorna resultado
}

// Analisador de descida recursiva. Os métodos de uma classe se enxergam independentemente
// da ordem em que são declarados, o que permite a recursão entre objetos, vetores e valores.
classe AnalisadorJson {
    codigo: texto
    posicao: inteiro
    erro: texto

    construtor(codigo: texto) {
        isto.codigo = codigo
        isto.posicao = 0
        isto.erro = ""
    }

    terminou(): lógico {
        retorna isto.posicao >= isto.codigo.tamanho()
    }

    atual(): texto {
        retorna isto.codigo[isto.posicao]
    }

    pularEspacos() {
        enquanto (isto.posicao < isto.codigo.tamanho()) {
            var c: texto = isto.codigo[isto.posicao]
            se (c == " " ou c == "\n" ou c == "\r" ou c == "\t") {
                isto.posicao = isto.posicao + 1
            } senao {
                sustar
            }
        }
    }

    falhar(mensagem: texto): ValorJson {
        se (isto.erro == "") {
            isto.erro = mensagem + " (posição " + texto(isto.posicao) + ")"
        }
        retorna ValorJson("nulo")
    }

    consumirPalavra(palavra: texto): lógico {
        se (isto.codigo.subtexto(isto.posicao, isto.posicao + palavra.tamanho()) == palavra) {
            isto.posicao = isto.posicao + palavra.tamanho()
            retorna verdadeiro
        }
        retorna falso
    }

    analisarTexto(): ValorJson {
        isto.posicao = isto.posicao + 1
        var resultado: texto = ""
        enquanto (isto.posicao < isto.codigo.tamanho()) {
            var c: texto = isto.codigo[isto.posicao]
            se (c == "\"") {
                isto.posicao = isto.posicao + 1
                retorna criarTextoJson(resultado)
            }
            se (c == "\\") {
                isto.posicao = isto.posicao + 1
                var escape: texto = isto.codigo[isto.posicao]
                se (escape == "n") { resultado = resultado + "\n" }
                senao se (escape == "r") { resultado = resultado + "\r" }
                senao se (escape == "t") { resultado = resultado + "\t" }
                senao se (escape == "b" ou escape == "f") { resultado = resultado + "" }
                senao se (escape == "u") {
                    // Sem conversão de código para caractere em Delégua: mantém a sequência.
                    resultado = resultado + "\\u" + isto.codigo.subtexto(isto.posicao + 1, isto.posicao + 5)
                    isto.posicao = isto.posicao + 4
                }
                senao { resultado = resultado + escape }
                isto.posicao = isto.posicao + 1
                continua
            }
            resultado = resultado + c
            isto.posicao = isto.posicao + 1
        }
        retorna isto.falhar("Texto JSON não terminado")
    }

    analisarNumero(): ValorJson {
        var inicio: inteiro = isto.posicao
        enquanto (isto.posicao < isto.codigo.tamanho() e "-+0123456789.eE".inclui(isto.codigo[isto.posicao])) {
            isto.posicao = isto.posicao + 1
        }
        var trecho: texto = isto.codigo.subtexto(inicio, isto.posicao)
        se (trecho == "" ou trecho == "-") {
            retorna isto.falhar("Número JSON inválido")
        }
        retorna criarNumeroJson(numero(trecho))
    }

    analisarObjeto(): ValorJson {
        isto.posicao = isto.posicao + 1
        var objeto: ValorJson = ValorJson("objeto")
        isto.pularEspacos()
        se (nao isto.terminou() e isto.atual() == "}") {
            isto.posicao = isto.posicao + 1
            retorna objeto
        }
        enquanto (isto.erro == "") {
            isto.pularEspacos()
            se (isto.terminou() ou isto.atual() != "\"") {
                retorna isto.falhar("Esperada chave de objeto JSON")
            }
            var chave: ValorJson = isto.analisarTexto()
            isto.pularEspacos()
            se (isto.terminou() ou isto.atual() != ":") {
                retorna isto.falhar("Esperado ':' em objeto JSON")
            }
            isto.posicao = isto.posicao + 1
            var valorLido: ValorJson = isto.analisarValor()
            se (isto.erro != "") { retorna ValorJson("nulo") }
            objeto.definirCampo(chave.textoValor, valorLido)
            isto.pularEspacos()
            se (isto.terminou()) {
                retorna isto.falhar("Objeto JSON não terminado")
            }
            var separador: texto = isto.atual()
            isto.posicao = isto.posicao + 1
            se (separador == "}") {
                retorna objeto
            }
            se (separador != ",") {
                retorna isto.falhar("Esperado ',' ou '}' em objeto JSON")
            }
        }
        retorna ValorJson("nulo")
    }

    analisarVetor(): ValorJson {
        isto.posicao = isto.posicao + 1
        var vetorLido: ValorJson = ValorJson("vetor")
        isto.pularEspacos()
        se (nao isto.terminou() e isto.atual() == "]") {
            isto.posicao = isto.posicao + 1
            retorna vetorLido
        }
        enquanto (isto.erro == "") {
            var itemLido: ValorJson = isto.analisarValor()
            se (isto.erro != "") { retorna ValorJson("nulo") }
            vetorLido.itens.adicionar(itemLido)
            isto.pularEspacos()
            se (isto.terminou()) {
                retorna isto.falhar("Vetor JSON não terminado")
            }
            var separador: texto = isto.atual()
            isto.posicao = isto.posicao + 1
            se (separador == "]") {
                retorna vetorLido
            }
            se (separador != ",") {
                retorna isto.falhar("Esperado ',' ou ']' em vetor JSON")
            }
        }
        retorna ValorJson("nulo")
    }

    analisarValor(): ValorJson {
        isto.pularEspacos()
        se (isto.terminou()) {
            retorna isto.falhar("Fim inesperado do JSON")
        }
        var c: texto = isto.atual()
        se (c == "{") { retorna isto.analisarObjeto() }
        se (c == "[") { retorna isto.analisarVetor() }
        se (c == "\"") { retorna isto.analisarTexto() }
        se (isto.consumirPalavra("true")) { retorna criarLogicoJson(verdadeiro) }
        se (isto.consumirPalavra("false")) { retorna criarLogicoJson(falso) }
        se (isto.consumirPalavra("null")) { retorna ValorJson("nulo") }
        se ("-0123456789".inclui(c)) { retorna isto.analisarNumero() }
        retorna isto.falhar("Caractere inesperado no JSON: '" + c + "'")
    }
}

// Analisa um texto JSON. `erro` não vazio no resultado indica falha.
funcao analisar(textoJson: texto): ResultadoJson {
    var analisador: AnalisadorJson = AnalisadorJson(textoJson)
    var lido: ValorJson = analisador.analisarValor()
    analisador.pularEspacos()
    se (analisador.erro == "" e nao analisador.terminou()) {
        analisador.falhar("Conteúdo após o fim do JSON")
    }
    se (analisador.erro != "") {
        retorna ResultadoJson(ValorJson("nulo"), analisador.erro)
    }
    retorna ResultadoJson(lido, "")
}

// Remove comentários de linha (//) e de bloco (/* */) fora de textos literais.
// `erro` não vazio no resultado indica comentário de bloco não fechado.
funcao removerComentarios(codigo: texto): ResultadoTextoJson {
    var saida: texto = ""
    var i: inteiro = 0
    var n: inteiro = codigo.tamanho()
    enquanto (i < n) {
        var c: texto = codigo[i]
        se (c == "\"") {
            saida = saida + c
            i = i + 1
            enquanto (i < n) {
                var d: texto = codigo[i]
                saida = saida + d
                i = i + 1
                se (d == "\\" e i < n) {
                    saida = saida + codigo[i]
                    i = i + 1
                } senao se (d == "\"") {
                    sustar
                }
            }
            continua
        }
        var seguinte: texto = ""
        se (i + 1 < n) { seguinte = codigo[i + 1] }
        se (c == "/" e seguinte == "/") {
            enquanto (i < n e codigo[i] != "\n") { i = i + 1 }
            continua
        }
        se (c == "/" e seguinte == "*") {
            i = i + 2
            var fechado: lógico = falso
            enquanto (i + 1 < n e nao fechado) {
                se (codigo[i] == "*" e codigo[i + 1] == "/") {
                    fechado = verdadeiro
                }
                i = i + 1
            }
            se (nao fechado) {
                retorna ResultadoTextoJson("", "Comentário de bloco não fechado")
            }
            i = i + 1
            continua
        }
        saida = saida + c
        i = i + 1
    }
    retorna ResultadoTextoJson(saida, "")
}

// Analisa um texto JSONC (JSON com comentários).
funcao analisarJsonc(textoJsonc: texto): ResultadoJson {
    var limpo: ResultadoTextoJson = removerComentarios(textoJsonc)
    se (limpo.erro != "") {
        retorna ResultadoJson(ValorJson("nulo"), limpo.erro)
    }
    retorna analisar(limpo.textoLimpo)
}
