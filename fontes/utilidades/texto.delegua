// Utilidades de texto. As primitivas de texto da realização node não têm `comecaCom`,
// e `substituir` troca apenas a primeira ocorrência.

funcao comecaCom(textoBase: texto, inicio: texto): lógico {
    se (inicio.tamanho() > textoBase.tamanho()) { retorna falso }
    retorna textoBase.subtexto(0, inicio.tamanho()) == inicio
}

funcao terminaCom(textoBase: texto, fim: texto): lógico {
    se (fim.tamanho() > textoBase.tamanho()) { retorna falso }
    retorna textoBase.subtexto(textoBase.tamanho() - fim.tamanho(), textoBase.tamanho()) == fim
}

funcao substituirTodos(textoBase: texto, procurado: texto, substituto: texto): texto {
    se (procurado == "") { retorna textoBase }
    retorna textoBase.dividir(procurado).juntar(substituto)
}

funcao ehDigito(caractere: texto): lógico {
    retorna caractere != "" e "0123456789".inclui(caractere)
}

// Equivale à expressão regular /^-?\d+(\.\d+)?$/.
funcao ehNumeroDecimal(textoValor: texto): lógico {
    var i: inteiro = 0
    se (textoValor.tamanho() > 0 e textoValor[0] == "-") { i = 1 }
    var inicioInteiro: inteiro = i
    enquanto (i < textoValor.tamanho() e ehDigito(textoValor[i])) { i = i + 1 }
    se (i == inicioInteiro) { retorna falso }
    se (i == textoValor.tamanho()) { retorna verdadeiro }
    se (textoValor[i] != ".") { retorna falso }
    i = i + 1
    var inicioFracao: inteiro = i
    enquanto (i < textoValor.tamanho() e ehDigito(textoValor[i])) { i = i + 1 }
    retorna i > inicioFracao e i == textoValor.tamanho()
}
