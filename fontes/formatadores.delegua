// Formatação dos resultados da linha de comando para exibição no terminal.
importar {
    AvisoValidacao,
    DefinicaoPropriedade,
    ErroCompreensao,
    ErroValidacao,
    ItemInfo,
    PropriedadeCompreendida,
    ResultadoCompreensao,
    ResultadoValidacao
} de "./modelos.delegua"

// Formata um ResultadoValidacao.
funcao formatarValidacao(validacao: ResultadoValidacao): texto {
    var linhas: texto[] = []
    var totalAvisos: inteiro = validacao.avisos.tamanho()
    var totalErros: inteiro = validacao.erros.tamanho()

    se (totalAvisos == 0 e totalErros == 0) {
        retorna "Arquivo válido. Nenhum aviso ou erro encontrado."
    }

    para (var i = 0; i < totalAvisos; i = i + 1) {
        var aviso: AvisoValidacao = validacao.avisos[i]
        linhas.adicionar("[Aviso] Linha " + texto(aviso.linha) + ": " + aviso.chave + " — " + aviso.mensagem)
    }

    para (var j = 0; j < totalErros; j = j + 1) {
        var erro: ErroValidacao = validacao.erros[j]
        var prefixo: texto = ""
        se (erro.chave != "") { prefixo = erro.chave + " — " }
        linhas.adicionar("[Erro] Linha " + texto(erro.linha) + ": " + prefixo + erro.mensagem)
    }

    linhas.adicionar("")
    linhas.adicionar("Resumo: " + texto(totalAvisos) + " aviso(s), " + texto(totalErros) + " erro(s).")
    retorna linhas.juntar("\n")
}

// Formata um ResultadoCompreensao.
funcao formatarCompreensao(resultado: ResultadoCompreensao): texto {
    var linhas: texto[] = []

    se (resultado.propriedades.tamanho() > 0) {
        linhas.adicionar("Propriedades encontradas:")
        para (var i = 0; i < resultado.propriedades.tamanho(); i = i + 1) {
            var propriedade: PropriedadeCompreendida = resultado.propriedades[i]
            linhas.adicionar("  Linha " + texto(propriedade.linha) + ": " + propriedade.chave + " = " + propriedade.valor)
        }
    } senao {
        linhas.adicionar("Nenhuma propriedade encontrada.")
    }

    se (resultado.erros.tamanho() > 0) {
        linhas.adicionar("")
        linhas.adicionar("Erros de sintaxe:")
        para (var j = 0; j < resultado.erros.tamanho(); j = j + 1) {
            var erro: ErroCompreensao = resultado.erros[j]
            linhas.adicionar("  Linha " + texto(erro.linha) + ": " + erro.mensagem)
        }
    }

    retorna linhas.juntar("\n")
}

// Formata a listagem de espaços de nomes e propriedades disponíveis.
funcao formatarEsquemas(esquemas: dicionário): texto {
    var linhas: texto[] = []
    linhas.adicionar("Espaços de nomes e propriedades disponíveis:")
    linhas.adicionar("")

    var espacos: texto[] = esquemas.chaves()
    para (var i = 0; i < espacos.tamanho(); i = i + 1) {
        var espaco: texto = espacos[i]
        var definicoes: DefinicaoPropriedade[] = esquemas[espaco]
        linhas.adicionar("  " + espaco + ":")

        para (var j = 0; j < definicoes.tamanho(); j = j + 1) {
            var definicao: DefinicaoPropriedade = definicoes[j]
            var textoPadrao: texto = ""
            se (definicao.valorPadrao != "") { textoPadrao = " (padrão: " + definicao.valorPadrao + ")" }
            var permitidos: texto = ""
            se (definicao.temValoresPermitidos()) { permitidos = " [" + definicao.valoresPermitidos.juntar(", ") + "]" }
            linhas.adicionar("    • " + definicao.nome + " (" + definicao.tipoValor + ")" + permitidos + textoPadrao)
            linhas.adicionar("      " + definicao.detalhe)
        }

        linhas.adicionar("")
    }

    retorna linhas.juntar("\n")
}

// Formata as informações de uma propriedade encontrada em um ou mais espaços de nomes.
funcao formatarInfo(resultados: ItemInfo[]): texto {
    se (resultados.tamanho() == 0) {
        retorna "Nenhuma propriedade encontrada com esse nome."
    }

    var linhas: texto[] = []
    para (var i = 0; i < resultados.tamanho(); i = i + 1) {
        var item: ItemInfo = resultados[i]
        var definicao: DefinicaoPropriedade = item.definicao

        linhas.adicionar("Propriedade: " + definicao.nome)
        linhas.adicionar("  Espaço de nomes: " + item.espacoNomes)
        linhas.adicionar("  Tipo:      " + definicao.tipoValor)
        linhas.adicionar("  Detalhe:   " + definicao.detalhe)

        se (definicao.temValoresPermitidos()) {
            linhas.adicionar("  Valores permitidos: [" + definicao.valoresPermitidos.juntar(", ") + "]")
        }

        se (definicao.valorPadrao != "") {
            linhas.adicionar("  Padrão:    " + definicao.valorPadrao)
        }

        linhas.adicionar("")
    }

    retorna linhas.juntar("\n")
}

// Texto de ajuda da linha de comando.
funcao formatarAjuda(): texto {
    var linhas: texto[] = [
        "delprops — Ferramenta de linha de comando para arquivos .delprops",
        "",
        "Uso:",
        "  delprops <comando> [argumentos]",
        "",
        "Comandos:",
        "  validar <caminho>                Compreende e valida um arquivo .delprops",
        "    --esquemas <caminho>             Caminho para arquivo JSON com esquemas",
        "                                     adicionais",
        "",
        "  compreender <caminho>            Compreende e exibe as propriedades do arquivo",
        "",
        "  info <propriedade>               Exibe detalhes de uma propriedade específica",
        "",
        "  esquemas                         Lista espaços de nomes e propriedades disponíveis",
        "",
        "  --ajuda                          Exibe esta mensagem de ajuda",
        "  --versao, -v                     Exibe a versão",
        "",
        "Exemplos:",
        "  delprops validar configuracao.delprops",
        "  delprops validar configuracao.delprops --esquemas meus-esquemas.json",
        "  delprops compreender configuracao.delprops",
        "  delprops info cors",
        "  delprops info tecnologia",
        "  delprops esquemas"
    ]
    retorna linhas.juntar("\n")
}
