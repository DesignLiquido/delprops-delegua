// Linha de comando do DelProps: validar, compreender, info e esquemas.
//
// A lógica não depende da realização: toda interação com o sistema passa por um objeto que
// implementa a interface SistemaCli (fontes/modelos.delegua). `sistemaCliLocal(argumentos)`
// (fontes/sistema_cli.delegua) implementa essa interface sobre as bibliotecas `arquivos` e
// `processo`.
importar tudo como analisador de "./analisador.delegua"
importar tudo como validador de "./validador.delegua"
importar tudo como formatadores de "./formatadores.delegua"
importar tudo como esquemasCli de "./esquemas.delegua"
importar tudo como textos de "./utilidades/texto.delegua"
importar {
    DefinicaoPropriedade,
    ErroCompreensao,
    ErroValidacao,
    ItemInfo,
    OpcoesCli,
    ResultadoCompreensao,
    ResultadoValidacao,
    SistemaCli
} de "./modelos.delegua"
importar { ResultadoEsquemas } de "./esquemas.delegua"

// Mantenha igual ao campo "versao" de pacoteca.jsonc (verificado pelos testes).
funcao versao(): texto {
    retorna "0.1.0"
}

funcao opcoesComErro(comando: texto, mensagem: texto): OpcoesCli {
    var opcoes: OpcoesCli = OpcoesCli(comando)
    opcoes.erro = mensagem
    retorna opcoes
}

// Interpreta os argumentos da linha de comando. Devolve um OpcoesCli.
funcao compreenderArgumentos(argumentos: texto[]): OpcoesCli {
    se (argumentos.tamanho() == 0) { retorna OpcoesCli("ajuda") }
    var comando: texto = argumentos[0]

    se (comando == "--ajuda" ou comando == "-h") { retorna OpcoesCli("ajuda") }
    se (comando == "--versao" ou comando == "-v") { retorna OpcoesCli("versao") }
    se (comando == "esquemas") { retorna OpcoesCli(comando) }

    se (comando == "info") {
        se (argumentos.tamanho() < 2 ou textos.comecaCom(argumentos[1], "-")) {
            retorna opcoesComErro(comando, "O comando 'info' requer o nome de uma propriedade.")
        }
        var opcoesInfo: OpcoesCli = OpcoesCli(comando)
        opcoesInfo.nomePropriedade = argumentos[1]
        retorna opcoesInfo
    }

    se (comando == "validar" ou comando == "compreender") {
        var opcoes: OpcoesCli = OpcoesCli(comando)
        var i: inteiro = 1
        enquanto (i < argumentos.tamanho()) {
            var argumento: texto = argumentos[i]
            se (argumento == "--esquemas") {
                i = i + 1
                se (i >= argumentos.tamanho() ou textos.comecaCom(argumentos[i], "-")) {
                    retorna opcoesComErro(comando, "A opção '--esquemas' requer um valor.")
                }
                opcoes.caminhoEsquemas = argumentos[i]
            } senao se (opcoes.caminhoArquivo == "") {
                opcoes.caminhoArquivo = argumento
            }
            i = i + 1
        }

        se (opcoes.caminhoArquivo == "") {
            retorna opcoesComErro(comando, "O comando '" + comando + "' requer o caminho de um arquivo .delprops.")
        }
        retorna opcoes
    }

    retorna opcoesComErro("ajuda", "Comando desconhecido: '" + comando + "'.")
}

// Resultado de `lerArquivoSeguro`.
classe LeituraArquivo {
    encontrado: lógico
    conteudo: texto

    construtor(encontrado: lógico, conteudo: texto) {
        isto.encontrado = encontrado
        isto.conteudo = conteudo
    }
}

// Lê um arquivo relativo ao diretório atual. Se o arquivo não existe, escreve a mensagem e
// devolve uma leitura com `encontrado` falso.
funcao lerArquivoSeguro(sistema: SistemaCli, caminho: texto): LeituraArquivo {
    var caminhoAbsoluto: texto = sistema.resolverCaminho(sistema.diretorioAtual(), caminho)

    se (nao sistema.existe(caminhoAbsoluto)) {
        sistema.escreverErro("Arquivo não encontrado: " + caminho + "\n")
        retorna LeituraArquivo(falso, "")
    }
    retorna LeituraArquivo(verdadeiro, sistema.lerArquivo(caminhoAbsoluto))
}

// Esquemas embutidos, mais os adicionais.
funcao montarEsquemas(esquemasAdicionais: dicionário): dicionário {
    var esquemas: dicionário = esquemasCli.obterEsquemasEmbutidos()
    esquemasCli.mesclarEsquemas(esquemas, esquemasAdicionais)
    retorna esquemas
}

funcao comandoAjuda(sistema: SistemaCli): inteiro {
    sistema.escreverSaida(formatadores.formatarAjuda() + "\n")
    retorna 0
}

funcao comandoVersao(sistema: SistemaCli): inteiro {
    sistema.escreverSaida("delprops v" + versao() + "\n")
    retorna 0
}

funcao comandoInfo(sistema: SistemaCli, nomePropriedade: texto, esquemasAdicionais: dicionário): inteiro {
    var esquemas: dicionário = montarEsquemas(esquemasAdicionais)
    var resultados: ItemInfo[] = []

    var espacos: texto[] = esquemas.chaves()
    para (var i = 0; i < espacos.tamanho(); i = i + 1) {
        var espaco: texto = espacos[i]
        var definicoes: DefinicaoPropriedade[] = esquemas[espaco]
        para (var j = 0; j < definicoes.tamanho(); j = j + 1) {
            var definicao: DefinicaoPropriedade = definicoes[j]
            se (definicao.nome == nomePropriedade) {
                resultados.adicionar(ItemInfo(espaco, definicao))
            }
        }
    }

    sistema.escreverSaida(formatadores.formatarInfo(resultados) + "\n")
    se (resultados.tamanho() == 0) { retorna 1 }
    retorna 0
}

funcao comandoEsquemas(sistema: SistemaCli, esquemasAdicionais: dicionário): inteiro {
    var esquemas: dicionário = montarEsquemas(esquemasAdicionais)
    sistema.escreverSaida(formatadores.formatarEsquemas(esquemas))
    sistema.escreverSaida("\n")
    retorna 0
}

funcao comandoCompreender(sistema: SistemaCli, caminhoArquivo: texto): inteiro {
    var leitura: LeituraArquivo = lerArquivoSeguro(sistema, caminhoArquivo)
    se (nao leitura.encontrado) { retorna 1 }

    var resultado: ResultadoCompreensao = analisador.analisar(leitura.conteudo)
    sistema.escreverSaida(formatadores.formatarCompreensao(resultado) + "\n")
    se (resultado.erros.tamanho() > 0) { retorna 1 }
    retorna 0
}

funcao comandoValidar(sistema: SistemaCli, caminhoArquivo: texto, caminhoEsquemas: texto, esquemasAdicionais: dicionário): inteiro {
    var leitura: LeituraArquivo = lerArquivoSeguro(sistema, caminhoArquivo)
    se (nao leitura.encontrado) { retorna 1 }

    var esquemas: dicionário = esquemasCli.obterEsquemasEmbutidos()

    se (caminhoEsquemas != "") {
        var externos: ResultadoEsquemas = esquemasCli.carregarEsquemasDeArquivo(sistema, caminhoEsquemas)
        se (externos.erro != "") { retorna 1 }
        esquemasCli.mesclarEsquemas(esquemas, externos.esquemas)
    }

    esquemasCli.mesclarEsquemas(esquemas, esquemasAdicionais)

    var compreendido: ResultadoCompreensao = analisador.analisar(leitura.conteudo)
    var resultado: ResultadoValidacao = validador.validar(compreendido.propriedades, esquemas)

    // Erros de compreensão (por exemplo, chaves duplicadas) também são erros de validação.
    para (var i = 0; i < compreendido.erros.tamanho(); i = i + 1) {
        var erro: ErroCompreensao = compreendido.erros[i]
        resultado.erros.adicionar(ErroValidacao("", erro.linha, erro.mensagem))
    }

    sistema.escreverSaida(formatadores.formatarValidacao(resultado) + "\n")
    se (resultado.erros.tamanho() > 0) { retorna 1 }
    retorna 0
}

// Executa o comando pedido nos argumentos do sistema. `esquemasAdicionais` (espaço de
// nomes → definições; pode ser vazio) complementa os esquemas embutidos.
// Chama `sistema.encerrar(codigo)` ao final e devolve o código de saída.
funcao executarCli(sistema: SistemaCli, esquemasAdicionais: dicionário): inteiro {
    var opcoes: OpcoesCli = compreenderArgumentos(sistema.obterArgumentos())
    var codigo: inteiro = 0

    se (opcoes.erro != "") {
        sistema.escreverErro(opcoes.erro + "\n")
        sistema.escreverSaida("\nExecute \"delprops --ajuda\" para obter ajuda.\n")
        codigo = 1
    } senao se (opcoes.comando == "ajuda") {
        codigo = comandoAjuda(sistema)
    } senao se (opcoes.comando == "versao") {
        codigo = comandoVersao(sistema)
    } senao se (opcoes.comando == "esquemas") {
        codigo = comandoEsquemas(sistema, esquemasAdicionais)
    } senao se (opcoes.comando == "info") {
        codigo = comandoInfo(sistema, opcoes.nomePropriedade, esquemasAdicionais)
    } senao se (opcoes.comando == "compreender") {
        codigo = comandoCompreender(sistema, opcoes.caminhoArquivo)
    } senao se (opcoes.comando == "validar") {
        codigo = comandoValidar(sistema, opcoes.caminhoArquivo, opcoes.caminhoEsquemas, esquemasAdicionais)
    } senao {
        sistema.escreverErro("Comando não implementado: '" + opcoes.comando + "'.\n")
        codigo = 1
    }

    sistema.encerrar(codigo)
    retorna codigo
}
