// Esquemas usados pela linha de comando: embutidos, lidos de arquivo e mesclados.
importar tudo como modelos de "./modelos.delegua"
importar tudo como liquido de "./liquido.delegua"
importar tudo como json de "./utilidades/json.delegua"

// Esquemas embutidos (liquido.*): espaço de nomes → vetor de DefinicaoPropriedade.
funcao obterEsquemasEmbutidos() {
    retorna liquido.esquemas()
}

// Converte um texto JSON (ou JSONC) `{ "<espaço de nomes>": [ definições ] }` em esquemas.
// Itens que não são vetores, e definições inválidas, são ignorados.
// Devolve { "esquemas": dicionário, "erro": "" }; `erro` não vazio indica falha.
funcao esquemasDeTexto(conteudo) {
    var lido = json.analisarJsonc(conteudo)
    se (lido["erro"] != "") {
        retorna { "esquemas": nulo, "erro": lido["erro"] }
    }
    var dados = lido["resultado"]
    se (nao modelos.ehDicionario(dados)) {
        retorna { "esquemas": nulo, "erro": "Esperado um objeto JSON de espaços de nomes." }
    }
    var esquemas = {}
    var espacos = dados.chaves()
    para (var i = 0; i < espacos.tamanho(); i = i + 1) {
        var espaco = espacos[i]
        var definicoes = dados[espaco]
        se (modelos.ehVetor(definicoes)) {
            esquemas[espaco] = modelos.definicoesDeVetor(definicoes)
        }
    }
    retorna { "esquemas": esquemas, "erro": "" }
}

// Carrega esquemas de um arquivo JSON externo. Em caso de erro, escreve a mensagem pelo
// sistema e devolve nulo.
funcao carregarEsquemasDeArquivo(sistema, caminho) {
    var caminhoAbsoluto = sistema.resolverCaminho(sistema.diretorioAtual(), caminho)

    se (nao sistema.existe(caminhoAbsoluto)) {
        sistema.escreverErro("Arquivo de esquemas não encontrado: " + caminho + "\n")
        retorna nulo
    }

    var conteudo = nulo
    tente {
        conteudo = sistema.lerArquivo(caminhoAbsoluto)
    } pegue (erro) {
        sistema.escreverErro("Erro ao carregar esquemas de '" + caminho + "': " + texto(erro) + "\n")
        retorna nulo
    }

    var resultado = esquemasDeTexto(conteudo)
    se (resultado["erro"] != "") {
        sistema.escreverErro("Erro ao carregar esquemas de '" + caminho + "': " + resultado["erro"] + "\n")
        retorna nulo
    }
    retorna resultado["esquemas"]
}

// Mescla os esquemas adicionais nos esquemas base (o dicionário base é alterado).
funcao mesclarEsquemas(base, adicionais) {
    var espacos = adicionais.chaves()
    para (var i = 0; i < espacos.tamanho(); i = i + 1) {
        var espaco = espacos[i]
        var mesclado = []
        se (base.contem(espaco)) {
            var existentes = base[espaco]
            para (var j = 0; j < existentes.tamanho(); j = j + 1) { mesclado.adicionar(existentes[j]) }
        }
        var novos = adicionais[espaco]
        para (var k = 0; k < novos.tamanho(); k = k + 1) { mesclado.adicionar(novos[k]) }
        base[espaco] = mesclado
    }
}
