// Sistema de arquivos de descoberta para a realização node, sobre a biblioteca `arquivos`.
importar tudo como arquivos de "arquivos"
importar tudo como modelos de "./modelos.delegua"

classe SistemaArquivosNode {
    construtor() {}

    existe(caminho) {
        retorna arquivos.existe(caminho)
    }

    listarDiretorio(caminho) {
        var entradas = []
        var nomes = arquivos.listarDiretorio(caminho)
        para (var i = 0; i < nomes.tamanho(); i = i + 1) {
            var nome = nomes[i]
            var ehDiretorio = arquivos.eDiretorio(arquivos.juntarCaminhos(caminho, nome))
            entradas.adicionar(modelos.EntradaDiretorio(nome, ehDiretorio))
        }
        retorna entradas
    }

    lerTexto(caminho) {
        retorna arquivos.lerTexto(caminho)
    }

    juntarCaminhos(base, parte) {
        retorna arquivos.juntarCaminhos(base, parte)
    }
}

funcao sistemaArquivosNode() {
    retorna SistemaArquivosNode()
}
