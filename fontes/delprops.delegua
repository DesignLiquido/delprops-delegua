// DelProps: análise e validação de arquivos .delprops, o formato de propriedades e
// configuração do ecossistema Delégua.
//
// Ponto de entrada do pacote (veja pacoteca.jsonc). Uso:
//
//     importar tudo como delprops de "delprops"
//
//     var compreendido = delprops.analisar(conteudo)
//     var resultado = delprops.validar(compreendido.propriedades, delprops.obterEsquemasEmbutidos())
//
// As estruturas devolvidas (PropriedadeCompreendida, ResultadoValidacao etc.) estão em
// fontes/modelos.delegua.
importar tudo como tiposDelprops de "./tipos.delegua"
importar tudo como modelos de "./modelos.delegua"
importar tudo como analisador de "./analisador.delegua"
importar tudo como validador de "./validador.delegua"
importar tudo como registroDelprops de "./registro.delegua"
importar tudo como descobridor de "./descobridor.delegua"
importar tudo como esquemasDelprops de "./esquemas.delegua"
importar tudo como formatadores de "./formatadores.delegua"
importar tudo como liquido de "./liquido.delegua"
importar tudo como cli de "./cli.delegua"
importar tudo como sistemaArquivos de "./sistema_arquivos_node.delegua"
importar tudo como sistemaCli de "./sistema_cli_node.delegua"

funcao versao() { retorna cli.versao() }

// ── Tipos e definições ──

funcao tiposValor() { retorna tiposDelprops.tiposValor() }

// Cria uma definição de propriedade. `valorPadrao` e `valoresPermitidos` podem ser nulo.
funcao definicaoPropriedade(nome, tipoValor, detalhe, valorPadrao, valoresPermitidos) {
    retorna modelos.DefinicaoPropriedade(nome, tipoValor, detalhe, valorPadrao, valoresPermitidos)
}

// Cria uma definição a partir de um dicionário { nome, tipo, detalhe, padrao?, valoresPermitidos? }.
funcao definicaoDeDicionario(dados) { retorna modelos.definicaoDeDicionario(dados) }

funcao definicoesDeVetor(dados) { retorna modelos.definicoesDeVetor(dados) }

// ── Análise e validação ──

// Devolve um ResultadoCompreensao { propriedades, erros }.
funcao analisar(conteudo) { retorna analisador.analisar(conteudo) }

// Devolve um ResultadoValidacao { avisos, erros }.
funcao validar(propriedades, esquemas) { retorna validador.validar(propriedades, esquemas) }

// Analisa e valida o conteúdo de um arquivo .delprops de uma vez. Os erros de compreensão
// (sintaxe, chaves duplicadas) entram como erros de validação com chave vazia.
funcao validarConteudo(conteudo, esquemas) {
    var compreendido = analisador.analisar(conteudo)
    var resultado = validador.validar(compreendido.propriedades, esquemas)
    para (var i = 0; i < compreendido.erros.tamanho(); i = i + 1) {
        var erro = compreendido.erros[i]
        resultado.erros.adicionar(modelos.ErroValidacao("", erro.linha, erro.mensagem))
    }
    retorna resultado
}

funcao inferirTipo(valor) { retorna validador.inferirTipo(valor) }

funcao valorSemAspas(valor) { retorna validador.valorSemAspas(valor) }

// ── Esquemas ──

// Esquemas embutidos (liquido.*): espaço de nomes → vetor de DefinicaoPropriedade.
funcao obterEsquemasEmbutidos() { retorna esquemasDelprops.obterEsquemasEmbutidos() }

// Esquemas embutidos do Líquido, por espaço de nomes (mesmo conteúdo de obterEsquemasEmbutidos).
funcao esquemasLiquido() { retorna liquido.esquemas() }

// Lê esquemas de um texto JSON/JSONC. Devolve { "esquemas": ..., "erro": "" }.
funcao esquemasDeTexto(conteudo) { retorna esquemasDelprops.esquemasDeTexto(conteudo) }

funcao mesclarEsquemas(base, adicionais) { esquemasDelprops.mesclarEsquemas(base, adicionais) }

// ── Registro e descoberta ──

// Cria um RegistroEsquemas vazio (registrar, obter, temRegistro, obterTodos, obterEsquemas).
funcao criarRegistro() { retorna registroDelprops.criarRegistro() }

// Registra no `registro` os esquemas declarados pelos pacotes em `diretorioPacotes`.
// Devolve a quantidade de contribuições registradas.
funcao descobrir(diretorioPacotes, sistema, registro) {
    retorna descobridor.descobrir(diretorioPacotes, sistema, registro)
}

// Sistema de arquivos de descoberta da realização node.
funcao sistemaArquivosNode() { retorna sistemaArquivos.sistemaArquivosNode() }

// ── Formatação e linha de comando ──

funcao formatarValidacao(resultado) { retorna formatadores.formatarValidacao(resultado) }
funcao formatarCompreensao(resultado) { retorna formatadores.formatarCompreensao(resultado) }
funcao formatarEsquemas(esquemas) { retorna formatadores.formatarEsquemas(esquemas) }
funcao formatarInfo(resultados) { retorna formatadores.formatarInfo(resultados) }
funcao formatarAjuda() { retorna formatadores.formatarAjuda() }

// Executa a linha de comando com o sistema dado. Devolve o código de saída.
funcao executarCli(sistema, esquemasAdicionais) { retorna cli.executarCli(sistema, esquemasAdicionais) }

// Sistema da linha de comando da realização node (argumentos do processo atual).
funcao sistemaCliNode() { retorna sistemaCli.sistemaCliNode() }
