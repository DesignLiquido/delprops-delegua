// Descoberta automática de esquemas contribuídos por pacotes instalados pela Pacoteca.
//
// A Pacoteca instala pacotes em `pacotes/<realizacao>/<nome>/`. Um pacote contribui com
// esquemas declarando, no seu `pacoteca.jsonc`:
//
//     "delprops": { "espacoNomes": "liquido.dados", "esquema": "delprops/dados.json" }
//
// ou um vetor de objetos assim. `esquema` é o caminho, relativo à raiz do pacote, de um
// arquivo JSON (ou JSONC) com um vetor de definições de propriedade.
//
// O sistema de arquivos é injetado: qualquer objeto com os métodos
//     existe(caminho) → lógico
//     listarDiretorio(caminho) → vetor de EntradaDiretorio
//     lerTexto(caminho) → texto
//     juntarCaminhos(base, parte) → texto
// serve. `sistemaArquivosNode()` (fontes/sistema_arquivos_node.delegua) usa a biblioteca
// `arquivos`.
importar tudo como modelos de "./modelos.delegua"
importar tudo como json de "./utilidades/json.delegua"

funcao nomeManifesto() {
    retorna "pacoteca.jsonc"
}

// Registra os esquemas de um manifesto `{ espacoNomes, esquema }`. Devolve 1 se registrou.
funcao registrarManifesto(manifesto, caminhoPacote, nomePacote, sistemaArquivos, registro) {
    se (nao modelos.ehDicionario(manifesto)) { retorna 0 }
    var espacoNomes = manifesto["espacoNomes"]
    var esquema = manifesto["esquema"]
    se (nao modelos.ehTexto(espacoNomes) ou nao modelos.ehTexto(esquema)) { retorna 0 }
    se (espacoNomes == "" ou esquema == "") { retorna 0 }
    se (registro.pacoteRegistrado(espacoNomes, nomePacote)) { retorna 0 }

    var caminhoEsquema = sistemaArquivos.juntarCaminhos(caminhoPacote, esquema)
    se (nao sistemaArquivos.existe(caminhoEsquema)) { retorna 0 }
    var lido = json.analisarJsonc(sistemaArquivos.lerTexto(caminhoEsquema))
    se (lido["erro"] != "" ou nao modelos.ehVetor(lido["resultado"])) { retorna 0 }

    registro.registrar(espacoNomes, nomePacote, modelos.definicoesDeVetor(lido["resultado"]))
    retorna 1
}

// Lê o `pacoteca.jsonc` de um pacote e registra suas contribuições. Devolve quantas registrou.
funcao tentarCarregar(caminhoPacote, nomeDiretorio, sistemaArquivos, registro) {
    var caminhoManifesto = sistemaArquivos.juntarCaminhos(caminhoPacote, nomeManifesto())
    se (nao sistemaArquivos.existe(caminhoManifesto)) { retorna 0 }

    var lido = json.analisarJsonc(sistemaArquivos.lerTexto(caminhoManifesto))
    se (lido["erro"] != "" ou nao modelos.ehDicionario(lido["resultado"])) { retorna 0 }
    var pacote = lido["resultado"]

    var nomePacote = nomeDiretorio
    se (modelos.ehTexto(pacote["nome"]) e pacote["nome"] != "") { nomePacote = pacote["nome"] }

    var entrada = pacote["delprops"]
    se (entrada == nulo) { retorna 0 }
    var manifestos = [entrada]
    se (modelos.ehVetor(entrada)) { manifestos = entrada }

    var total = 0
    para (var i = 0; i < manifestos.tamanho(); i = i + 1) {
        total = total + registrarManifesto(manifestos[i], caminhoPacote, nomePacote, sistemaArquivos, registro)
    }
    retorna total
}

// Percorre o diretório de pacotes e registra no `registro` (RegistroEsquemas) os esquemas
// que os pacotes declaram.
// Aceita tanto `pacotes/<realizacao>` quanto `pacotes/` (nesse caso, percorre cada
// realização). Pacotes repetidos em várias realizações são registrados uma vez.
// Devolve a quantidade de contribuições registradas.
//
// Exemplo:
//     var registro = criarRegistro()
//     descobrir(arquivos.juntarCaminhos(diretorioProjeto, "pacotes"), sistemaArquivosNode(), registro)
//     var esquemas = registro.obterEsquemas()
funcao descobrir(diretorioPacotes, sistemaArquivos, registro) {
    se (nao sistemaArquivos.existe(diretorioPacotes)) { retorna 0 }

    var total = 0
    var entradas = sistemaArquivos.listarDiretorio(diretorioPacotes)
    para (var i = 0; i < entradas.tamanho(); i = i + 1) {
        var entrada = entradas[i]
        se (nao entrada.ehDiretorio) { continua }
        var caminho = sistemaArquivos.juntarCaminhos(diretorioPacotes, entrada.nome)

        se (sistemaArquivos.existe(sistemaArquivos.juntarCaminhos(caminho, nomeManifesto()))) {
            total = total + tentarCarregar(caminho, entrada.nome, sistemaArquivos, registro)
            continua
        }

        // Diretório de uma realização (pacotes/node, pacotes/llvm...).
        var subentradas = sistemaArquivos.listarDiretorio(caminho)
        para (var j = 0; j < subentradas.tamanho(); j = j + 1) {
            var subentrada = subentradas[j]
            se (subentrada.ehDiretorio) {
                total = total + tentarCarregar(
                    sistemaArquivos.juntarCaminhos(caminho, subentrada.nome),
                    subentrada.nome,
                    sistemaArquivos,
                    registro
                )
            }
        }
    }
    retorna total
}
